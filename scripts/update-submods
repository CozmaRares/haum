#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

mapfile -t submodules < <(
    git config --file .gitmodules --get-regexp '^submodule\..*\.path$' |
        sed 's/^[^ ]* //'
)

if ((${#submodules[@]} == 0)); then
    echo "==> No submodules configured."
    exit 0
fi

echo "==> Updating app submodules from their configured remotes..."
git submodule update --remote --recursive -- "${submodules[@]}"

echo "==> Staging updated submodule refs..."
git add -- "${submodules[@]}"

if git diff --cached --quiet; then
    echo "==> No submodule ref changes to commit."
else
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    commit_message="$(mktemp)"
    trap 'rm -f "$commit_message"' EXIT
    {
        printf 'update submodules %s\n\n' "$timestamp"

        for submodule in "${submodules[@]}"; do
            if git diff --cached --quiet -- "$submodule"; then
                continue
            fi

            old_ref="$(git rev-parse "HEAD:${submodule}")"
            new_ref="$(git rev-parse ":${submodule}")"
            first_line="$(git -C "$submodule" log -1 --format=%s "$new_ref")"

            printf '%s: %s -> %s %s\n' \
                "${submodule##*/}" \
                "${old_ref:0:7}" \
                "${new_ref:0:7}" \
                "$first_line"
        done
    } >"$commit_message"

    echo "==> Committing updated submodule refs..."
    git commit -F "$commit_message"
    rm -f "$commit_message"
    trap - EXIT
fi

echo "==> Current submodule refs:"
git submodule status -- "${submodules[@]}"

echo "==> Pushing updated submodule refs..."
git push
